{
  "name": "betterphotos",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "compile": "sass --watch --no-source-map src/main.scss src/style.css",
    "build:compile": "sass --no-source-map src/main.scss build/compiled.css",
    "build:prefixes": "postcss build/compiled.css --use autoprefixer --output build/prefixed.css",
    "build:optimize": "postcss build/prefixed.css --use cssnano --output build/style.css",
    "build": "npm run build:compile && npm run build:prefixes && npm run build:optimize"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "postcss-cli": "12.0.0",
    "sass": "1.106.1",
    "cssnano": "9.9.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
